{% extends 'base.html.twig' %}

{% block title %}Categorias{% endblock %}

{% block body %}
    <h1>Categorias</h1>

    <p><a class="btn" href="{{ path('app_categoria_new') }}">+ Nova categoria</a></p>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Produtos</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
        {% for categoria in categorias %}
            <tr>
                <td>{{ categoria.id }}</td>
                <td>{{ categoria.nome }}</td>
                <td>{{ categoria.produtos|length }}</td>
                <td>
                    <div class="acoes">
                        <a class="btn btn-secondary" href="{{ path('app_categoria_show', {id: categoria.id}) }}">Ver</a>
                        <a class="btn btn-secondary" href="{{ path('app_categoria_edit', {id: categoria.id}) }}">Editar</a>
                        {{ include('categoria/_delete_form.html.twig') }}
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="4">Nenhuma categoria cadastrada.</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}