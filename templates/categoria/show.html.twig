{% extends 'base.html.twig' %}

{% block title %}{{ categoria.nome }}{% endblock %}

{% block body %}
    <h1>{{ categoria.nome }}</h1>

    <table>
        <tbody>
            <tr><th>ID</th><td>{{ categoria.id }}</td></tr>
            <tr><th>Nome</th><td>{{ categoria.nome }}</td></tr>
            <tr><th>Produtos</th><td>{{ categoria.produtos|length }}</td></tr>
        </tbody>
    </table>

    <div class="acoes">
        <a class="btn btn-secondary" href="{{ path('app_categoria_index') }}">Voltar</a>
        <a class="btn" href="{{ path('app_categoria_edit', {id: categoria.id}) }}">Editar</a>
        {{ include('categoria/_delete_form.html.twig') }}
    </div>
{% endblock %}