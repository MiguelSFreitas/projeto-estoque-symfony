{% extends 'base.html.twig' %}

{% block title %}Entrar no Sistema{% endblock %}

{% block body %}
<div class="login-wrapper">
    <div class="login-card">
        <form method="post">
            
            <h1 class="login-title">Acessar Sistema</h1>

            {% if error %}
                <div class="alert-error">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="logged-in-box">
                    Você já está conectado como <strong>{{ app.user.userIdentifier }}</strong>.<br>
                    <a href="{{ logout_path() }}">Sair da conta</a>
                </div>
            {% endif %}

            <div class="form-group">
                <label for="username" class="form-label">E-mail</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus placeholder="seu@email.com">
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Senha</label>
                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required placeholder="••••••••">
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

           
            <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem;">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me" style="font-size: 0.875rem; margin-bottom: 0;">Lembrar de mim</label>
            </div>
            

            <button class="btn-login" type="submit">
                Entrar
            </button>
        </form>
    </div>
</div>
{% endblock %}