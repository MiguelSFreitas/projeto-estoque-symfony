{% extends 'base.html.twig' %}

{% block title %}Produtos{% endblock %}

{% block body %}
    <h1>Produtos</h1>

    <p><a class="btn" href="{{ path('app_produto_new') }}">+ Novo produto</a></p>

    <table>
        <thead>
            <tr>
                <th>Código</th>
                <th>Nome</th>
                <th>Categoria</th>
                <th>Preço</th>
                <th>Estoque</th>
                <th>Ativo</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
        {% for produto in produtos %}
            <tr>
                <td>{{ produto.codigo }}</td>
                <td>{{ produto.nome }}</td>
                <td>{{ produto.categoria.nome }}</td>
                <td>R$ {{ produto.preco|number_format(2, ',', '.') }}</td>
                <td>
                    {{ produto.quantidade }}
                    {% if produto.estoqueBaixo %}<strong style="color:#dc2626">(baixo)</strong>{% endif %}
                </td>
                <td>{{ produto.ativo ? 'Sim' : 'Não' }}</td>
                <td>
                    <div class="acoes">
                        <a class="btn btn-secondary" href="{{ path('app_produto_show', {id: produto.id}) }}">Ver</a>
                        <a class="btn btn-secondary" href="{{ path('app_produto_edit', {id: produto.id}) }}">Editar</a>
                        {{ include('produto/_delete_form.html.twig') }}
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="7">Nenhum produto cadastrado.</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}