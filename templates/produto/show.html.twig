{% extends 'base.html.twig' %}

{% block title %}{{ produto.nome }}{% endblock %}

{% block body %}
    <h1>{{ produto.nome }}</h1>

    <table>
        <tbody>
            <tr><th>Código</th><td>{{ produto.codigo }}</td></tr>
            <tr><th>Categoria</th><td>{{ produto.categoria.nome }}</td></tr>
            <tr><th>Descrição</th><td>{{ produto.descricao ?: '—' }}</td></tr>
            <tr><th>Preço</th><td>R$ {{ produto.preco|number_format(2, ',', '.') }}</td></tr>
            <tr><th>Quantidade</th><td>{{ produto.quantidade }}</td></tr>
            <tr><th>Estoque mínimo</th><td>{{ produto.estoqueMinimo }}</td></tr>
            <tr><th>Ativo</th><td>{{ produto.ativo ? 'Sim' : 'Não' }}</td></tr>
            <tr><th>Criado em</th><td>{{ produto.criadoEm|date('d/m/Y H:i') }}</td></tr>
        </tbody>
    </table>

    <div class="acoes">
        <a class="btn btn-secondary" href="{{ path('app_produto_index') }}">Voltar</a>
        <a class="btn" href="{{ path('app_produto_edit', {id: produto.id}) }}">Editar</a>
        {{ include('produto/_delete_form.html.twig') }}
    </div>
{% endblock %}